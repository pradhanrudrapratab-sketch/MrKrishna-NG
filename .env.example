# Use digits with country code, without + or spaces
OWNER_NUMBER=91XXXXXXXXXX
WHATSAPP_NUMBER=91YYYYYYYYYY

# Generate a long random value; required for /api/send
API_KEY=replace-with-a-long-random-secret

# Base32 secret from `npm run setup:totp`
ADMIN_TOTP_SECRET=REPLACE_WITH_BASE32_SECRET

# Leave blank on first boot. Paste the latest admin session export here to restore it.
WHATSAPP_SESSION=

PORT=3000
NODE_ENV=development
# Optional numeric Express trust-proxy hop count. Render uses one proxy hop by default.
TRUST_PROXY_HOPS=1
